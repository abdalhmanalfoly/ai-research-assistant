# ======================================================================
# AI Research Assistant — environment template. PLACEHOLDERS ONLY.
# Copy to .env (never commit .env). Variables marked [USED] are read by
# app/core/config.py today. Variables marked [NOT USED YET] are reserved
# for future Supabase Storage/Auth work and are ignored by the current code.
# ======================================================================

APP_ENV=development                 # [USED]
LOG_LEVEL=INFO                      # [USED]

# --- Database [USED] ---------------------------------------------------
# Local Docker Postgres (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
#
# Supabase (Dashboard -> Connect). Driver prefix MUST be postgresql+psycopg://
# Percent-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
#   Direct (IPv6; migrations + long-lived backend):
#     postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   Session pooler (IPv4 networks; supports prepared statements; recommended on Windows/home networks):
#     postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   Transaction pooler (port 6543): also set DB_DISABLE_PREPARED_STATEMENTS=true
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING
DB_DISABLE_PREPARED_STATEMENTS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- LLM via Ollama [USED] ----------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
LLM_MAX_OUTPUT_TOKENS=700

# --- Embeddings [USED]: local Hugging Face model, no Ollama involved ---------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024                  # must match the vector(1024) column (migration 0003)
EMBEDDING_DEVICE=auto               # auto | cpu | cuda | cuda:N   (explicit cuda without CUDA = clear error)
EMBEDDING_BATCH_SIZE=16             # lower to 4-8 on a small GPU (VRAM shared with Qwen)
EMBEDDING_DTYPE=float32             # float32 | float16 (fp16 is used only on CUDA)
EMBEDDING_MAX_SEQ_LENGTH=512        # BGE-large maximum
EMBEDDING_NORMALIZE=true            # L2-normalise documents AND queries; search uses cosine distance
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "   # queries only
EMBEDDING_DOCUMENT_PREFIX=          # BGE: passages get no instruction
EMBEDDING_CACHE_DIR=                # empty = default Hugging Face cache (HF_HOME)
EMBEDDING_OFFLINE=false             # true = never contact the Hub (model must already be cached)
EMBEDDING_PRELOAD_ON_STARTUP=false  # true = load model at API start instead of first use

# --- Retrieval [USED] ---------------------------------------------------
RETRIEVAL_TOP_K=5
# UNCALIBRATED for BGE (0.45 was a placeholder chosen for nomic-embed-text). Run: python -m scripts.calibrate_threshold
RETRIEVAL_THRESHOLD=0.45
EVIDENCE_BUDGET_CHARS=              # empty = derived from LLM_NUM_CTX
CHUNK_MAX_CHARS=1200

# --- PDFs [USED] --------------------------------------------------------
CORS_ORIGINS=                       # only needed if the frontend is served from another origin, e.g. http://localhost:5500
SERVE_FRONTEND=true                 # serve ./frontend at http://localhost:8000/
MAX_PDF_MB=50
STORAGE_DIR=./data/storage          # local disk today; Supabase Storage is NOT implemented

# --- OCR for scanned PDFs [USED] ---------------------------------------
OCR_ENABLED=true
OCR_PROVIDER=auto                   # auto | rapidocr | tesseract | none
OCR_LANGUAGE=eng                    # Tesseract only (e.g. eng, ara, eng+ara); RapidOCR uses its bundled model
OCR_DPI=200                         # page render resolution for OCR; higher = slower, usually better
OCR_MIN_PAGE_CHARS=25               # pages with less extractable text are treated as scanned
OCR_MAX_PAGES=0                     # 0 = no limit; guard against very large scanned documents

# --- Supabase [NOT USED YET] -------------------------------------------
# Backend-only. Never put the secret key in a frontend, Git, screenshots or chat.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY       # safe for browsers ONLY because RLS protects the tables
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY                 # bypasses RLS. Server-side only.
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
